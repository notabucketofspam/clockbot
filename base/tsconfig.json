{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    "moduleResolution": "nodenext",
    "types": [ "node" ],
    "target": "esnext",

    "module": "nodenext",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,

    "skipLibCheck": true
  }
}